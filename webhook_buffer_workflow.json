    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://example.com/api/payments/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Provider",
              "value": "={{ $('Разбор вебхука').item.json.env.provider }}"
