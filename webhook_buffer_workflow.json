        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Разбор вебхука').item.json.payload) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "w-http",
      "name": "Отдать заказ вашей системе",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
