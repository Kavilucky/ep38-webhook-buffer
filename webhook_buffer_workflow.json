    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ошибка отдачи заказа вашей системе: увеличиваем счётчик попыток; после 5 попыток вебхук уходит в список webhooks:dead\nconst src = $('Разбор вебхука').item.json.env;\nconst attempts = (Number(src.attempts) || 0) + 1;\nconst next = { ...src, attempts };\nreturn { json: { next: JSON.stringify(next), dead: attempts > 5 } };"
      },
      "id": "w-retry",
      "name": "Счётчик попыток",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        420
      ],
      "notes": "Why Code: пересборка конверта с увеличенным счётчиком попыток."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.dead }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w-dead",
      "name": "Попыток больше 5?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        420
      ]
    },
    {
      "parameters": {
        "operation": "push",
        "list": "webhooks:dead",
        "messageData": "={{ $json.next }}",
        "tail": false
      },
      "id": "w-pushdead",
      "name": "В список ошибок webhooks:dead",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        2160,
        340
      ],
      "credentials": {
        "redis": {
          "id": "",
          "name": "Redis (контейнер redis)"
        }
      }
    },
    {
      "parameters": {
        "operation": "push",
        "list": "webhooks:in",
        "messageData": "={{ $json.next }}",
        "tail": true
      },
      "id": "w-back",
      "name": "Вернуть в очередь и остановиться",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
