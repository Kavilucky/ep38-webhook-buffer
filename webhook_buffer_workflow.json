{
  "name": "Буфер платёжных вебхуков: безопасная вычитка очереди Redis (эп. 38)",
  "nodes": [
    {
      "parameters": {
        "content": "## Буфер платёжных вебхуков (эпизод 38)\n1. Создайте учётные данные Redis: хост redis, порт 6379.\n2. В узле «Отдать заказ вашей системе» замените адрес на свой обработчик.\n3. Запустите вручную (в очереди должно быть что-то: см. Инструкция.txt), затем включите сценарий.\nОчередь: webhooks:in, ошибки: webhooks:dead. Каждые 30 с сценарий выбирает очередь по одной оплате с паузой 0,3 с.",
        "height": 240,
        "width": 520
      },
      "id": "w-note",
      "name": "Памятка",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "id": "w-trigger",
      "name": "Каждые 30 секунд",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "operation": "pop",
        "list": "webhooks:in",
        "tail": true,
        "propertyName": "item"
      },
      "id": "w-pop",
      "name": "Достать оплату из очереди",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        240,
        160
      ],
      "credentials": {
        "redis": {
          "id": "",
          "name": "Redis (контейнер redis)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.item }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w-has",
      "name": "Есть оплата?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Разбор конверта из очереди (его кладёт шлюз) и идентификатор платежа для проверки дубля\nconst env = JSON.parse($json.item);\nlet body = null;\ntry { body = JSON.parse(env.body); } catch (e) { body = null; }\nlet id = env.id;                       // запасной вариант: идентификатор конверта\nif (env.provider === 'stripe' && body && body.id) id = 'stripe:' + body.id;\nelse if (env.provider === 'yookassa' && body && body.object && body.object.id) id = 'yookassa:' + (body.event || '') + ':' + body.object.id;\nelse if (env.provider === 'robokassa') {\n  const m = /(?:^|&)InvId=([^&]+)/.exec(env.body || '');\n  if (m) id = 'robokassa:' + decodeURIComponent(m[1]);\n}\nreturn { json: { env, event_id: id, payload: body !== null ? body : { raw: env.body } } };"
      },
      "id": "w-parse",
      "name": "Разбор вебхука",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        160
      ],
      "notes": "Why Code: разбор конверта шлюза (JSON внутри JSON) и выбор идентификатора платежа по провайдеру."
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{ 'seen:' + $json.event_id }}",
        "propertyName": "seen",
        "keyType": "string"
      },
      "id": "w-seen",
      "name": "Уже обработан?",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        960,
        160
      ],
      "credentials": {
